# ===============================================================
#          VARIABLES D'ENVIRONNEMENT POUR LE PROJET ETL
# ===============================================================
#
# Instructions :
# 1. Copiez ce fichier et renommez-le en ".env"
# 2. Remplissez les valeurs marquées comme <REQUIS> ci-dessous.
#
# ---------------------------------------------------------------

# --- ⚙️ CONFIGURATION DU PIPELINE ETL ---

# Niveau de logs par défaut pour l'application ETL
# Options : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


# --- 📦 CONFIGURATION DES SERVICES DOCKER ---
# Ces variables sont utilisées par docker-compose pour configurer les conteneurs.
# Vous n'avez généralement pas besoin de les modifier.

MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=medical_db

# Chemins des volumes à l'intérieur des conteneurs
DATA_DIR=/app/data
LOG_DIR=/app/logs


# --- 🔐 SECRETS ET IDENTIFIANTS (À REMPLIR) ---

# Utilisateur principal de la base de données (avec droits d'écriture)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD= # <REQUIS: Choisissez un mot de passe robuste pour l'utilisateur root>

# Utilisateur pour l'analyse (avec droits de lecture seule)
MONGO_ANALYST_USER=analyst
MONGO_ANALYST_PASSWORD= # <REQUIS: Choisissez un mot de passe pour l'utilisateur analyste>

# Identifiants pour l'interface web Mongo Express (http://localhost:8081)
WEB_USERNAME=admin
WEB_PASSWORD= # <REQUIS: Choisissez un mot de passe pour l'interface web>


# --- 🐍 CONFIGURATION AVANCÉE PYTHON ---
# Ne pas mettre la sortie Python en cache, utile pour voir les logs en temps réel dans Docker.
PYTHONUNBUFFERED=1